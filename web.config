<?xml version="1.0" encoding="UTF-8"?>
<!-- Configurazione per l'installazione su IIS (copiata in dist/, vedi CLAUDE.md) -->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- Le versioni meno recenti di IIS non conoscono .webp:
           senza questa riga le immagini restano in 404. Il remove evita l'errore
           di voce duplicata sulle versioni che lo conoscono già -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".txt" />
      <mimeMap fileExtension=".txt" mimeType="text/plain; charset=utf-8" />
    </staticContent>
  </system.webServer>
</configuration>
